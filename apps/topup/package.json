{
  "name": "@antseed/topup",
  "version": "0.1.0",
  "description": "x402 top-up gateway — fund AntSeed buyer deposits with Meridian x402 payments",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antseed/node": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "ethers": "~6.16.0",
    "fastify": "^5.7.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
