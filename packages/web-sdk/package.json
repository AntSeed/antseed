{
  "name": "@antseed/web-sdk",
  "version": "0.1.0",
  "description": "Browser buyer SDK for AntSeed: connect to sellers over WebRTC via a signaling relay, pay with in-browser EIP-712 signatures",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node ../../scripts/remove-paths.mjs dist",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antseed/buyer-core": "workspace:*",
    "@antseed/protocol": "workspace:*",
    "ethers": "~6.16.0"
  },
  "devDependencies": {
    "@antseed/node": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.12",
    "node-datachannel": "^0.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.18.0"
  }
}
