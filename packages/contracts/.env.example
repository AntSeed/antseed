# Base Sepolia deployment config
DEPLOYER_PRIVATE_KEY=0x...your_private_key
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=your_basescan_api_key
PROTOCOL_RESERVE=0x...protocol_reserve_addr
TEAM_ADDRESS=0x...team_wallet_address

# Recognized-usage cutover (DeployRecognizedUsage.s.sol + CutoverFlip.s.sol)
# Broadcast #1 (DeployRecognizedUsage) — DEPLOYER_PRIVATE_KEY must own
# ANTSToken and the legacy emissions contract.
ANTSEED_REGISTRY=0x...legacy_registry_addr
VERIFICATION_WALLET=0x...verification_bucket_recipient
#EMISSIONS_RESERVE_WALLET=0x...optional_reserve_minter_controller
# Broadcast #2 (CutoverFlip / scripts/cutover-flip.sh) — next epoch.
#USAGE_ACCOUNTING=0x...printed_by_deploy
#POINTS_POLICY_REGISTRY=0x...printed_by_deploy
#SELLER_REGISTRY=0x...printed_by_deploy
#DIEM_STAKING_PROXY=0x...deployed_diem_proxy
#REGISTRY_OWNER_PRIVATE_KEY=0x...registry_owner_key
#DIEM_STAKER_PRIVATE_KEY=0x...key_with_diem_staked_on_proxy
#SELLER_REWARDS_POOL_OWNER_PRIVATE_KEY=0x...pool_owner_key_if_not_the_staker
#CHANNELS_OWNER_PRIVATE_KEY=0x...channels_owner_key_if_not_the_staker

# Wash-trading points policy registration (RegisterWashTradingPointsPolicy.s.sol)
#POINTS_POLICY_REGISTRY_OWNER_PRIVATE_KEY=0x...points_registry_owner_key
#WASH_TRADING_REGISTRY=0x...deployed_wash_trading_proof_registry
#RISC0_VERIFIER=0xA326b2eb45A5C3C206dF905A58970DcA57B8719e
#CHECKPOINT_IMAGE_ID=0x...base_checkpoint_guest_image_id
#HISTORICAL_CHUNK_IMAGE_ID=0xc1cc15f700032158b03f782aaa7aa23f02851ab6f6a0ba8452beb504eecf0475
# Pin only production-built guest image IDs and the governance-approved proof bundle root.
#COHORT_IMAGE_ID=0x...cohort_guest_image_id
#RECIPROCAL_IMAGE_ID=0x...reciprocal_guest_image_id
#APPROVED_REPORT_ROOT=0x...proof_bundle_report_root
#BASE_STATE_ORACLE=0x...deployed_antseed_base_checkpoint_oracle
