# Base Sepolia deployment config
# Legacy scripts only. M001 never reads a private key: pass wallets with
# `--signer <role>=account:<name>|keystore:<path>|ledger[:i]` instead.
DEPLOYER_PRIVATE_KEY=0x...your_private_key
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=your_basescan_api_key
PROTOCOL_RESERVE=0x...protocol_reserve_addr
TEAM_ADDRESS=0x...team_wallet_address

# Recognized-usage cutover (M001RecognizedUsage Deploy + Cutover). The CLI
# fills the addresses below from deployments/<network>/current.json; set
# them only when invoking the Foundry scripts by hand.
ANTSEED_REGISTRY=0x...legacy_registry_addr
EXPECTED_ANTS_TOKEN=0x...current_ants_token
EXPECTED_CHANNELS=0x...current_channels
EXPECTED_LEGACY_EMISSIONS=0x...current_emissions
EXPECTED_LEGACY_STAKING=0x...current_staking
VERIFICATION_WALLET=0x...verification_bucket_recipient
WASH_TRADING_REGISTRY=0x...deployed_wash_trading_registry # pinned into PositionInit
#EMISSIONS_RESERVE_WALLET=0x...optional_reserve_minter_controller
#POSITION_INIT_AMOUNT=1000000000000000000
#POSITION_INIT_END_EPOCH=0 # optional; default is effective epoch + 104
# Broadcast #2 (M001 Cutover) — next epoch. Signers are addresses, given via
# --signer on the CLI (or as env when running the Foundry script by hand):
#DEPLOYER=0x...
#REGISTRY_OWNER=0x...
#CHANNELS_OWNER=0x...
#DIEM_STAKING_PROXY=0x...deployed_diem_proxy   # omit on testnets without a proxy
#DIEM_STAKER=0x...address_with_diem_staked     # required with the proxy
#SELLER_REWARDS_POOL_OWNER=0x...               # required with the proxy
#USAGE_ACCOUNTING=0x...printed_by_deploy
#SELLER_REGISTRY=0x...printed_by_deploy

# Legacy seller claim policy (installed by M001 Cutover on the deployed
# AntseedSellerRewardsPool, signed as SELLER_REWARDS_POOL_OWNER).
# WASH_TRADING_REGISTRY above is reused; unset it to install with only the owner flag.
#RELEASE_BPS=1538                  # share of cumulative locked rewards released (10/65)
#VEST_START_EPOCH=0                # optional linear vesting start epoch
#VEST_EPOCHS=0                     # optional linear vesting length; 0 = immediate
