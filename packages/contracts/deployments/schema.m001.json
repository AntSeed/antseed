{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antseed.network/schemas/contract-deployment-m001.json",
  "title": "M001RecognizedUsage release invariants",
  "$comment": "Extra guarantees the recognized-usage rollout must prove. M001 deploys the shared points-policy foundation only: the verification bucket stays editable at 10%, no penalty policy is active, and both administrative contracts have recorded owners.",
  "type": "object",
  "required": ["verificationConfiguration"],
  "properties": {
    "verificationConfiguration": {
      "type": "object",
      "required": [
        "verificationMinterController",
        "verificationMinterShareBps",
        "verificationMinterEditable",
        "pointsPolicyCount",
        "emissionsGateOwner",
        "pointsPolicyRegistryOwner"
      ],
      "properties": {
        "verificationMinterController": { "$ref": "#/$defs/address" },
        "verificationMinterShareBps": { "const": 10000 },
        "verificationMinterEditable": { "const": true },
        "pointsPolicyCount": { "const": 0 },
        "emissionsGateOwner": { "$ref": "#/$defs/address" },
        "pointsPolicyRegistryOwner": { "$ref": "#/$defs/address" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  }
}
