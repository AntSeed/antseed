{
  "name": "@antseed/router-classifier",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor-neutral reference router for an AntSeed classifier service",
  "type": "module",
  "files": ["dist", "README.md"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@antseed/router-local": "workspace:*"
  },
  "peerDependencies": {
    "@antseed/node": ">=0.1.0"
  },
  "devDependencies": {
    "@antseed/node": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
